# --- App ---
APP_NAME="Timothy"
SECRET_KEY="cambia-esto-por-una-cadena-larga-y-aleatoria"
DATABASE_URL="sqlite:///./data/app.db"
DOCUMENTOS_DIR="./data/documentos"
PLANTILLAS_DIR="./plantillas"
DEBUG=true

# --- IA (Groq) ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-20b"

# --- Google Sheets (Service Account) ---
# Ruta al JSON de la service account. Comparte el sheet con el client_email de ese JSON.
GOOGLE_SERVICE_ACCOUNT_FILE="./secrets/service_account.json"
SHEET_ID="1AbCdEf..."
SHEET_WORKSHEET="Respuestas de formulario 1"

# --- Gmail API (OAuth de usuario, patron reusado del proyecto previo) ---
# En local: genera el token con `python scripts/autorizar_gmail.py` y usa las
# rutas a archivo de abajo.
GMAIL_CREDENTIALS_FILE="./secrets/gmail_credentials.json"
GMAIL_TOKEN_FILE="./secrets/gmail_token.json"
# En produccion (Vercel u otro serverless sin filesystem persistente): pega
# aca el CONTENIDO completo de secrets/gmail_token.json (una sola linea) en
# vez de usar GMAIL_TOKEN_FILE. Si esta variable esta definida, tiene
# prioridad sobre GMAIL_TOKEN_FILE.
# GMAIL_TOKEN_JSON='{"token": "...", "refresh_token": "...", ...}'
GMAIL_SENDER="despacho@henaolegal.com"
ABOGADO_EMAIL="abogado@henaolegal.com"

# --- Usuario admin inicial (usado por scripts/crear_usuario.py) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiame"
